# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 88

[*.{mq5,mq4,mqh}]
# MetaEditor's own convention: 3-space indent, CRLF. Matching it keeps diffs clean
# when a contributor edits in MetaEditor rather than a general-purpose editor.
indent_size = 3
end_of_line = crlf

[*.set]
# MT5 writes .set files with CRLF and reads them back the same way.
end_of_line = crlf
trim_trailing_whitespace = false

[*.md]
# Two trailing spaces are a hard line break in markdown.
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.sh]
indent_size = 2

[Makefile]
indent_style = tab
